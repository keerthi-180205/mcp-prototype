# GitHub API Configuration
# Optional: Provide a GitHub personal access token (PAT) to increase rate limits from 60 req/hr to 5,000 req/hr
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT=20

# Hugging Face API Configuration
# Optional: Access token for gated or private datasets
HF_TOKEN=
HF_API_BASE_URL=https://huggingface.co/api/datasets
HF_TIMEOUT=20

# Kaggle API Configuration
# Required for Kaggle API dataset metadata access
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_BASE_URL=https://www.kaggle.com/api/v1/datasets/view
KAGGLE_TIMEOUT=20

# Zenodo API Configuration
# Optional: Access token for private records or higher rate limits
ZENODO_TOKEN=
ZENODO_API_BASE_URL=https://zenodo.org/api/records
ZENODO_TIMEOUT=20

# Google Gemini API Configuration
# Required for Gemini LLM interpretation, summarization, and relevance analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT=90

# TrueScrape API Configuration (1 credit per call; cache hits and failed/empty calls are free)
# Used for: Reddit search + comments, Instagram comments. Its Instagram *discovery* endpoints are
# currently blocked upstream (need residential proxies), so Instagram posts are found via Apify.
TRUESCRAPE_API_KEY=
TRUESCRAPE_API_BASE_URL=https://api.truescrape.com
TRUESCRAPE_TIMEOUT=30

# Apify API Configuration
# Optional legacy fallback for Instagram
APIFY_API_TOKEN=
APIFY_API_BASE_URL=https://api.apify.com/v2
APIFY_INSTAGRAM_SEARCH_ACTOR=apify/instagram-scraper
APIFY_INSTAGRAM_COMMENTS_ACTOR=apify/instagram-comment-scraper
APIFY_TIMEOUT=120
# Hard per-query caps for comment collection (protect credits; the chatbot cannot raise these)
APIFY_MAX_COMMENTS_PER_QUERY=1500
APIFY_MAX_COST_PER_QUERY_USD=0.5
# Max recent posts to scan per query when discovering Instagram posts (also limited to 40% of the cost cap)
INSTAGRAM_DISCOVERY_POSTS=120
# Measured Apify prices used for the cost estimate (pay-per-result, no per-run fee)
APIFY_COST_PER_RESULT_USD=0.0027
APIFY_COST_PER_COMMENT_USD=0.0026

# Reddit (rdt-cli): value of the browser's `reddit_session` cookie. Written to
# ~/.config/rdt-cli/credential.json automatically.
REDDIT_SESSION=

# X / Twitter (twitter-cli): the `auth_token` and `ct0` cookies of a logged-in x.com session
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# YouTube Configuration
# Powered by yt-dlp binary (local, zero API keys required for public video and comment discovery)

# SocialCrawl API Configuration (1 credit per call, Instagram hashtag search 5)
# Used for: LinkedIn search + comments (the only LinkedIn source), and as a paid fallback for X / Reddit.
SOCIALCRAWL_API_KEY=
SOCIALCRAWL_BASE_URL=https://www.socialcrawl.dev
SOCIALCRAWL_TIMEOUT=30

# Bright Data. The free tier gives 5,000 credits a month (no card), shared by SERP / Web Unlocker / Web Scraper.
# SERP API = Google search results as JSON; used to find X / Instagram / LinkedIn posts and, with
# scripts/serp_search.py, therapists' public profiles. Create a "SERP API" zone in the Bright Data control
# panel; if the account has exactly one SERP zone it is found automatically (zones can be renamed or deleted
# without touching this file). Set the name below only to pin a zone when you have several.
BRIGHTDATA_API_KEY=
BRIGHTDATA_BASE_URL=https://api.brightdata.com
BRIGHTDATA_TIMEOUT=30
BRIGHTDATA_SERP_ZONE=
# Optional: two-letter country for Google results (e.g. in, us). Empty = Bright Data default.
BRIGHTDATA_SERP_COUNTRY=

# Spending limits per provider, in credits (0 = unlimited). When a limit is reached the provider is
# switched off for that job and the next one in the chain takes over.
BUDGET_TRUESCRAPE_PER_JOB=60
BUDGET_TRUESCRAPE_PER_DAY=200
BUDGET_SOCIALCRAWL_PER_JOB=30
BUDGET_SOCIALCRAWL_PER_DAY=100
# Bright Data: 1 credit per search; 150/day keeps the 5,000 free credits lasting the whole month
BUDGET_BRIGHTDATA_PER_JOB=40
BUDGET_BRIGHTDATA_PER_DAY=150

# YouTube (yt-dlp) optional tuning: path to a cookies.txt, and the player client (default: mweb)
YOUTUBE_COOKIES_FILE=
YOUTUBE_PLAYER_CLIENT=mweb

# Apify: optional flat fee per actor run (0 = pay-per-result only)
APIFY_COST_PER_RUN_USD=0

# Web app
HOST=127.0.0.1
PORT=8080
# Extra comma-separated CORS origins besides localhost:5173 / localhost:8080
CORS_ORIGINS=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_INITIAL_DELAY=0.5
RETRY_BACKOFF_FACTOR=2.0
RETRY_MAX_DELAY=8.0

# Optional: when set, the therapist-finder REST routes (/api/professionals*) require "Authorization: Bearer <token>".
# They expose contact details and spend search credits; set this before exposing the web app beyond localhost.
PROFESSIONALS_API_TOKEN=
